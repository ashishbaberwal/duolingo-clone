{
  "name": "duolingo-clone",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "db:migrate": "pnpm --filter @duo/backend db:migrate",
    "db:seed": "pnpm --filter @duo/backend db:seed",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "check": "turbo lint check-types test build"
  },
  "devDependencies": {
    "turbo": "^2.10.6"
  }
}

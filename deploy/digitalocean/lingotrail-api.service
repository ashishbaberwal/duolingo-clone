[Unit]
Description=LingoTrail FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lingotrail
Group=lingotrail
WorkingDirectory=/opt/lingotrail/backend
EnvironmentFile=/etc/lingotrail/api.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/lingotrail/backend/.venv/bin/alembic upgrade head
ExecStartPre=/opt/lingotrail/backend/.venv/bin/python -m app.seed
ExecStart=/opt/lingotrail/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lingotrail

[Install]
WantedBy=multi-user.target

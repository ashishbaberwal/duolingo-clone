API_DOMAIN=api.your-domain.example
APP_ENV=production
FRONTEND_ORIGIN=https://lingotrail-scaler.vercel.app
DATABASE_URL=sqlite:////var/lib/lingotrail/lingotrail.db
DATABASE_ECHO=false
DEFAULT_LEARNER_USERNAME=learner
DEMO_LEARNER_PASSWORD=LingoTrail@123
AUTH_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
AUTH_COOKIE_NAME=lingotrail_session
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_ISSUER=lingotrail-api
AUTH_AUDIENCE=lingotrail-web

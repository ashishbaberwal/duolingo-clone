APP_NAME=LingoTrail API
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./data/lingotrail.db
DATABASE_ECHO=false
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_COOKIE_NAME=lingotrail_session
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_ISSUER=lingotrail-api
AUTH_AUDIENCE=lingotrail-web

{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "check-types"],
      "env": [
        "API_PROXY_TARGET",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_AUTH_COOKIE_NAME"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "env": [
        "API_PROXY_TARGET",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_AUTH_COOKIE_NAME"
      ]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
